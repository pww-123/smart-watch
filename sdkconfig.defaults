CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_COLOR_DEPTH_16=y

# 表盘 + 信息页共 90 多个对象，默认 32KB 内存池余量不足
CONFIG_LV_MEM_SIZE_KILOBYTES=64

# 默认选 GC9A01，而不是示例默认的 ILI9341
CONFIG_EXAMPLE_LCD_CONTROLLER_GC9A01=y

# 日志同时走两个口：UART0(GPIO43/44 -> CH343 -> COM 口) 为主，
# USB Serial/JTAG 为副。这样插 UART 口或原生 USB 口都能看到 ESP_LOGI。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# N16R8 是 16MB flash，不是默认的 2MB
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 调试期：崩溃时打印完整回溯后停 3 秒再重启，便于在监视器里看清报错
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3

# 主任务要创建 90+ 个 LVGL 对象，默认 3584 字节偏紧
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# 崩溃根因修复（2026-11-03）：
# SPI 后台检查在 IDLE 任务里执行，默认 1536 字节栈不够，
# 回溯混入 esp_vApplicationIdleHook / spi_bus_lock_bg_check_dev_acq 即此溢出。
# 加大 IDLE 栈，并打开编译器栈检查，让栈溢出能被精确定位而不是踩踏相邻内存。
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=3072
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y

# 以后启用 8MB OPI PSRAM 时再打开下面三行
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_80M=y
