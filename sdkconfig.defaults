CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_COLOR_DEPTH_16=y

# 默认选 GC9A01，而不是示例默认的 ILI9341
CONFIG_EXAMPLE_LCD_CONTROLLER_GC9A01=y

# 日志走 USB Serial/JTAG，这样插原生 USB 口就能在监视器看到 ESP_LOGI
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# N16R8 是 16MB flash，不是默认的 2MB
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 以后启用 8MB OPI PSRAM 时再打开下面三行
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_80M=y
